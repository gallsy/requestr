@inherits LayoutComponentBase
@inject ThemeService ThemeService
@inject Requestr.Web.Configuration.AppBrandingOptions Branding
@using Requestr.Core.Services.Workflow
@inject IWorkflowExecutionService WorkflowExecutionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IFormDesignService FormDesignService
@inject IJSRuntime JSRuntime
@inject IUserTimezoneService UserTimezoneService
@implements IDisposable

<div class="page @(_isSidebarOpen ? "sidebar-open" : null)" data-theme="@(_isDarkMode ? "dark" : "light")">
    <div class="sidebar p-3">
        <div class="sidebar-header mb-4">
            <h5 class="mb-0 fw-semibold">@Branding.ApplicationName</h5>
        </div>
        
        <nav class="nav flex-column">
            <NavLink class="nav-link sidebar-nav-link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
            
            <NavLink class="nav-link sidebar-nav-link" href="/forms">
                New Request
            </NavLink>
            
            <NavLink class="nav-link sidebar-nav-link" href="requests">
                All Requests
            </NavLink>
            
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link sidebar-nav-link" href="approvals">
                        Approvals
                        @if (UserHasPendingWorkflowSteps)
                        {
                            <span class="badge bg-primary ms-auto">!</span>
                        }
                    </NavLink>
                </Authorized>
            </AuthorizeView>
            
            @if (_canManageForms)
            {
                <NavLink class="nav-link sidebar-nav-link" href="admin/forms">
                    Manage Forms
                </NavLink>
            }

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="nav-section-label">Admin</div>
                    <NavLink class="nav-link sidebar-nav-link" href="admin/workflows">
                        Manage Workflows
                    </NavLink>
                    <NavLink class="nav-link sidebar-nav-link" href="admin/notifications">
                        Notifications
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
    </div>
    
    <!-- Overlay for mobile when sidebar is open -->
    <div class="sidebar-overlay d-md-none" @onclick="CloseSidebar"></div>

    <main class="main">
        <div class="top-row px-4 auth">
            <div class="d-flex align-items-center ms-n2">
                <button type="button" class="btn btn-link text-decoration-none sidebar-toggle-btn d-md-none me-2" @onclick="ToggleSidebar" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <ThemeToggle />
                <LoginDisplay />
            </div>
        </div>

        <article class="content px-4">
            <div class="container-fluid">
                @Body
            </div>
        </article>
    </main>
</div>

<!-- Global Toast Notifications -->
<Toasts class="p-3" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />

@code {
    private bool _isDarkMode;
    private bool _isSidebarOpen = false;
    private bool UserHasPendingWorkflowSteps = false;
    private bool _canManageForms;
    private int _workflowCheckVersion;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        ThemeService.OnThemeChanged += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        
        await CheckUserWorkflowSteps();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !UserTimezoneService.IsInitialized)
        {
            try
            {
                var timezone = await JSRuntime.InvokeAsync<string>("getUserTimezone");
                if (!string.IsNullOrEmpty(timezone))
                {
                    UserTimezoneService.SetTimezone(timezone);
                    StateHasChanged();
                }
            }
            catch
            {
                // JS interop can fail during prerendering — safe to ignore
            }
        }
    }

    private async Task CheckUserWorkflowSteps()
    {
        var version = ++_workflowCheckVersion;
        var canManageForms = false;
        var hasPendingSteps = false;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var currentUserId = UserIdentityHelper.GetUserId(authState.User);

                var userRoles = ClaimsHelper.GetUserRoles(authState.User);

                canManageForms = userRoles.Contains("Admin") ||
                    (await FormDesignService.GetEditableFormsAsync(authState.User)).Any();

                if (!string.IsNullOrEmpty(currentUserId))
                {
                    var pendingSteps = await WorkflowExecutionService.GetPendingStepsForUserAsync(currentUserId, userRoles);
                    hasPendingSteps = pendingSteps?.Any() == true;
                }
            }
        }
        catch (Exception)
        {
            // Silent fail - navigation will default to role-based access only
            hasPendingSteps = false;
        }
        if (!_disposed && version == _workflowCheckVersion)
        {
            _canManageForms = canManageForms;
            UserHasPendingWorkflowSteps = hasPendingSteps;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(RefreshNavigationAsync);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) => _ = InvokeAsync(RefreshNavigationAsync);

    private async Task RefreshNavigationAsync()
    {
        if (_disposed) return;
        await CheckUserWorkflowSteps();
        if (!_disposed) StateHasChanged();
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }

    private void CloseSidebar()
    {
        _isSidebarOpen = false;
    }

    public void Dispose()
    {
        _disposed = true;
        _workflowCheckVersion++;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
