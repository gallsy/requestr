@inherits LayoutComponentBase
@inject Requestr.Web.Configuration.AppBrandingOptions Branding
@using Requestr.Core.Services.Workflow
@inject IWorkflowExecutionService WorkflowExecutionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IFormDesignService FormDesignService
@inject IJSRuntime JSRuntime
@inject IUserTimezoneService UserTimezoneService
@implements IDisposable

@* Collapsed state is styled from html[data-sidebar] (set in <head>) to avoid a flash on load. *@
<div class="page @(_isSidebarOpen ? "sidebar-open" : null)">
    <div id="main-navigation" class="sidebar p-3">
        <div class="sidebar-header mb-4">
            <h5 class="sidebar-brand mb-0 fw-semibold">@Branding.ApplicationName</h5>
            <button type="button" class="btn btn-link text-decoration-none sidebar-toggle-btn d-none d-md-inline-flex" @onclick="ToggleDesktopSidebar"
                    aria-controls="main-navigation" aria-expanded="@(!_isSidebarCollapsed ? "true" : "false")"
                    aria-label="@(_isSidebarCollapsed ? "Expand navigation" : "Collapse navigation")" title="@(_isSidebarCollapsed ? "Expand navigation" : "Collapse navigation")">
                <i class="bi @(_isSidebarCollapsed ? "bi-chevron-double-right" : "bi-chevron-double-left")" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-link text-decoration-none sidebar-toggle-btn d-md-none" @onclick="CloseSidebar"
                    aria-controls="main-navigation" aria-label="Close navigation" title="Close navigation">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        
        <nav class="nav flex-column" aria-label="Main navigation">
            <NavLink class="nav-link sidebar-nav-link" href="" Match="NavLinkMatch.All" aria-label="Home" title="Home">
                <i class="bi bi-house-door sidebar-icon" aria-hidden="true"></i>
                <span class="sidebar-label">Home</span>
            </NavLink>
            
            <NavLink class="nav-link sidebar-nav-link" href="/forms" aria-label="New Request" title="New Request">
                <i class="bi bi-plus-square sidebar-icon" aria-hidden="true"></i>
                <span class="sidebar-label">New Request</span>
            </NavLink>
            
            <NavLink class="nav-link sidebar-nav-link" href="requests" aria-label="All Requests" title="All Requests">
                <i class="bi bi-inbox sidebar-icon" aria-hidden="true"></i>
                <span class="sidebar-label">All Requests</span>
            </NavLink>
            
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link sidebar-nav-link" href="approvals"
                             aria-label="@(UserHasPendingWorkflowSteps ? "Approvals (pending approvals)" : "Approvals")" title="Approvals">
                        <i class="bi bi-check2-square sidebar-icon" aria-hidden="true"></i>
                        <span class="sidebar-label">Approvals</span>
                        @if (UserHasPendingWorkflowSteps)
                        {
                            <span class="badge sidebar-approval-badge bg-primary ms-auto" title="Pending approvals">!</span>
                        }
                    </NavLink>
                </Authorized>
            </AuthorizeView>
            
            @if (_canManageForms)
            {
                <NavLink class="nav-link sidebar-nav-link" href="admin/forms" aria-label="Manage Forms" title="Manage Forms">
                    <i class="bi bi-ui-checks sidebar-icon" aria-hidden="true"></i>
                    <span class="sidebar-label">Manage Forms</span>
                </NavLink>
            }

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="nav-section-label"><span class="sidebar-label">Admin</span></div>
                    <NavLink class="nav-link sidebar-nav-link" href="admin/workflows" aria-label="Manage Workflows" title="Manage Workflows">
                        <i class="bi bi-diagram-3 sidebar-icon" aria-hidden="true"></i>
                        <span class="sidebar-label">Manage Workflows</span>
                    </NavLink>
                    <NavLink class="nav-link sidebar-nav-link" href="admin/notifications" aria-label="Notifications" title="Notifications">
                        <i class="bi bi-bell sidebar-icon" aria-hidden="true"></i>
                        <span class="sidebar-label">Notifications</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="sidebar-footer">
            <LoginDisplay />
        </div>
    </div>
    
    <!-- Overlay for mobile when sidebar is open -->
    <div class="sidebar-overlay d-md-none" @onclick="CloseSidebar"></div>

    <main class="main">
        @* Only shown on small screens, where the sidebar is a drawer *@
        <header class="top-row d-md-none">
            <button type="button" class="btn btn-link text-decoration-none sidebar-toggle-btn" @onclick="ToggleSidebar" aria-label="Toggle navigation"
                    aria-controls="main-navigation" aria-expanded="@(_isSidebarOpen ? "true" : "false")" title="Toggle navigation">
                <i class="bi bi-list fs-4" aria-hidden="true"></i>
            </button>
            <span class="top-row-brand fw-semibold">@Branding.ApplicationName</span>
        </header>

        <article class="content px-4">
            <div class="container-fluid">
                @Body
            </div>
        </article>
    </main>
</div>

<!-- Global Toast Notifications -->
<Toasts class="p-3" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />

@code {
    [CascadingParameter] public Requestr.Web.Configuration.UiPreferences? UiPreferences { get; set; }

    private bool _isSidebarOpen = false;
    private bool _isSidebarCollapsed;
    private bool UserHasPendingWorkflowSteps = false;
    private bool _canManageForms;
    private int _workflowCheckVersion;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _isSidebarCollapsed = UiPreferences?.SidebarCollapsed ?? false;
        Navigation.LocationChanged += OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        
        await CheckUserWorkflowSteps();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var collapsed = await JSRuntime.InvokeAsync<bool>("requestrUi.isSidebarCollapsed");
                if (collapsed != _isSidebarCollapsed)
                {
                    _isSidebarCollapsed = collapsed;
                    StateHasChanged();
                }
            }
            catch (JSException) { }
        }
        if (firstRender && !UserTimezoneService.IsInitialized)
        {
            try
            {
                var timezone = await JSRuntime.InvokeAsync<string>("getUserTimezone");
                if (!string.IsNullOrEmpty(timezone))
                {
                    UserTimezoneService.SetTimezone(timezone);
                    StateHasChanged();
                }
            }
            catch
            {
                // JS interop can fail during prerendering — safe to ignore
            }
        }
    }

    private async Task CheckUserWorkflowSteps()
    {
        var version = ++_workflowCheckVersion;
        var canManageForms = false;
        var hasPendingSteps = false;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var currentUserId = UserIdentityHelper.GetUserId(authState.User);

                var userRoles = ClaimsHelper.GetUserRoles(authState.User);

                canManageForms = userRoles.Contains("Admin") ||
                    (await FormDesignService.GetEditableFormsAsync(authState.User)).Any();

                if (!string.IsNullOrEmpty(currentUserId))
                {
                    var pendingSteps = await WorkflowExecutionService.GetPendingStepsForUserAsync(currentUserId, userRoles);
                    hasPendingSteps = pendingSteps?.Any() == true;
                }
            }
        }
        catch (Exception)
        {
            // Silent fail - navigation will default to role-based access only
            hasPendingSteps = false;
        }
        if (!_disposed && version == _workflowCheckVersion)
        {
            _canManageForms = canManageForms;
            UserHasPendingWorkflowSteps = hasPendingSteps;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(RefreshNavigationAsync);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) => _ = InvokeAsync(RefreshNavigationAsync);

    private async Task RefreshNavigationAsync()
    {
        if (_disposed) return;
        await CheckUserWorkflowSteps();
        if (!_disposed) StateHasChanged();
    }

    private void ToggleSidebar()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }

    private async Task ToggleDesktopSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
        try
        {
            await JSRuntime.InvokeVoidAsync("requestrUi.setSidebarCollapsed", _isSidebarCollapsed);
        }
        catch (JSException) { }
    }

    private void CloseSidebar()
    {
        _isSidebarOpen = false;
    }

    public void Dispose()
    {
        _disposed = true;
        _workflowCheckVersion++;
        Navigation.LocationChanged -= OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
