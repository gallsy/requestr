@* Account menu pinned to the bottom of the sidebar. *@
<AuthorizeView>
    <Authorized>
        @{
            var email = context.User.Identity?.Name;
            var name = context.User.FindFirst("name")?.Value ?? email ?? "Account";
            var roles = context.User.Claims
                .Where(c => c.Type == "roles" || c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" || c.Type == ClaimTypes.Role)
                .Select(c => c.Value)
                .Distinct()
                .ToList();
        }
        <div class="dropup sidebar-account">
            @* Fixed positioning lets the menu escape the sidebar's overflow when it is collapsed. *@
            <button class="sidebar-account-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                    data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="@($"Account menu for {name}")" title="@name">
                <span class="sidebar-avatar" aria-hidden="true">@Initials(name)</span>
                <span class="sidebar-label sidebar-account-text">
                    <span class="d-block text-truncate fw-semibold">@name</span>
                    @if (!string.IsNullOrEmpty(email) && email != name)
                    {
                        <small class="d-block text-truncate text-muted">@email</small>
                    }
                </span>
                <i class="bi bi-three-dots-vertical sidebar-label ms-auto" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu sidebar-account-menu">
                <div class="px-3 pt-1 pb-2">
                    <div class="fw-semibold text-break">@name</div>
                    @if (!string.IsNullOrEmpty(email) && email != name)
                    {
                        <small class="text-muted text-break">@email</small>
                    }
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @if (roles.Any())
                        {
                            @foreach (var role in roles)
                            {
                                <span class="badge bg-secondary">@role</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">No roles</span>
                        }
                    </div>
                </div>
                <hr class="dropdown-divider">
                <div class="px-3 py-1">
                    <div class="small text-muted mb-1">Theme</div>
                    <ThemeToggle />
                </div>
                <hr class="dropdown-divider">
                <a class="dropdown-item" href="MicrosoftIdentity/Account/SignOut">
                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out
                </a>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="MicrosoftIdentity/Account/SignIn" class="btn btn-primary w-100 sidebar-signin" title="Sign in">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span class="sidebar-label ms-2">Sign in</span>
        </a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string Initials(string name)
    {
        var local = name.Split('@')[0];
        var parts = local.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
        };
    }
}
