@* Light / Dark / System theme picker shown in the account menu. *@
@inject ThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="theme-picker" role="group" aria-label="Theme">
    @foreach (var option in Options)
    {
        var selected = _preference == option.Value;
        <button type="button" class="theme-option @(selected ? "active" : null)" aria-pressed="@(selected ? "true" : "false")"
                @onclick="() => SetPreference(option.Value)">
            <i class="bi @option.Icon" aria-hidden="true"></i><span>@option.Label</span>
        </button>
    }
</div>

@code {
    private static readonly (string Value, string Label, string Icon)[] Options =
        [("light", "Light", "bi-sun"), ("dark", "Dark", "bi-moon-stars"), ("system", "System", "bi-circle-half")];

    private string _preference = "system";
    private DotNetObjectReference<ThemeToggle>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _preference = await JSRuntime.InvokeAsync<string?>("requestrUi.getThemePreference") ?? "system";
            ThemeService.SetTheme(await JSRuntime.InvokeAsync<bool>("requestrUi.isDarkTheme"));
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("requestrUi.subscribeTheme", _dotNetRef);
            StateHasChanged();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private async Task SetPreference(string preference)
    {
        _preference = preference;
        try
        {
            ThemeService.SetTheme(await JSRuntime.InvokeAsync<bool>("requestrUi.setThemePreference", preference));
        }
        catch (JSException) { }
    }

    [JSInvokable]
    public async Task SyncThemePreference(string preference)
    {
        _preference = preference;
        try { ThemeService.SetTheme(await JSRuntime.InvokeAsync<bool>("requestrUi.isDarkTheme")); }
        catch (JSException) { }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
