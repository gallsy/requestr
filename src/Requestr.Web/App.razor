@using Requestr.Web.Configuration
@inject ThemeService ThemeService
@inject AppBrandingOptions Branding

<CascadingValue Value="_uiPreferences" IsFixed="true">
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <PageTitle>Sign in | @Branding.ApplicationName</PageTitle>
                        <div class="card mt-4">
                            <div class="card-body">
                                <EmptyState Title="Please sign in" Icon="bi-box-arrow-in-right"
                                            Description="@($"You need to sign in to use {Branding.ApplicationName}.")">
                                    <Action>
                                        <a href="/MicrosoftIdentity/Account/SignIn" class="btn btn-primary">
                                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in
                                        </a>
                                    </Action>
                                </EmptyState>
                            </div>
                        </div>
                    }
                    else
                    {
                        <PageTitle>Access denied | @Branding.ApplicationName</PageTitle>
                        <div class="card mt-4">
                            <div class="card-body">
                                <EmptyState Title="Access denied" Icon="bi-shield-lock"
                                            Description="You don't have permission to view this page. Contact your administrator if you think this is a mistake.">
                                    <Action>
                                        <a href="/" class="btn btn-primary"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Go home</a>
                                    </Action>
                                </EmptyState>
                            </div>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Page not found | @Branding.ApplicationName</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="card mt-4">
                    <div class="card-body">
                        <EmptyState Title="Page not found" Icon="bi-signpost-split"
                                    Description="The page you're looking for doesn't exist or may have moved.">
                            <Action>
                                <a href="/" class="btn btn-primary"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Go home</a>
                            </Action>
                        </EmptyState>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
</CascadingValue>

@code {
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public bool SidebarCollapsed { get; set; }

    private UiPreferences _uiPreferences = new(false, false);

    protected override void OnInitialized()
    {
        _uiPreferences = new(DarkMode, SidebarCollapsed);
        ThemeService.SetTheme(DarkMode);
    }
}
