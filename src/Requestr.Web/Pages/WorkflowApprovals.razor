@page "/approvals"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Requestr.Core.Models
@using Requestr.Core.Models.DTOs
@using Requestr.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using BlazorBootstrap
@inject IFormRequestQueryService FormRequestQueryService
@inject IFormDefinitionService FormDefinitionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<WorkflowApprovals> Logger
@attribute [Authorize]

@inject Requestr.Web.Configuration.AppBrandingOptions Branding
@inject IUserTimezoneService Tz
<PageTitle>Approvals | @Branding.ApplicationName</PageTitle>

<PageHeader Title="Approvals" Description="Review and process form requests awaiting approval" />

    <FilterBar ShowClear="HasActiveFilters" OnClear="ClearFilters">
        <select class="form-select form-select-sm" aria-label="Status" @bind="SelectedStatusFilter" @bind:after="ApplyFilters">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="InProgress">In Progress</option>
            <option value="Completed">Completed</option>
            <option value="Skipped">Skipped</option>
            <option value="Failed">Failed</option>
        </select>
        <select class="form-select form-select-sm" aria-label="Form" @bind="SelectedFormFilter" @bind:after="ApplyFilters">
            <option value="">All Forms</option>
            @foreach (var form in _availableForms)
            {
                <option value="@form.Id">@form.Name</option>
            }
        </select>
        <select class="form-select form-select-sm" aria-label="Sort order" @bind="SortOrder" @bind:after="ApplyFilters">
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
        </select>
    </FilterBar>

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <StandardAlert AlertType="success" 
                             Message="@SuccessMessage" />
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <StandardAlert AlertType="danger" 
                             Message="@ErrorMessage" />
            }

            <div class="card">
                    @if (IsLoading)
                    {
                        <div class="card-body">
                            <LoadingSpinner Message="Loading approvals..." />
                        </div>
                    }
                    else if (!FilteredTasks.Any())
                    {
                        <div class="card-body">
                            <EmptyState Title="No pending approvals" 
                                        Description="@GetEmptyStateDescription()" />
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Form</th>
                                        <th>Step</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Requested By</th>
                                        <th>Date</th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in FilteredTasks)
                                    {
                                        <tr>
                                            <td>
                                                @if (task.Request.BulkFormRequestId.HasValue)
                                                {
                                                    <strong>Bulk #@task.Request.BulkFormRequestId</strong>
                                                }
                                                else
                                                {
                                                    <strong>#@task.Request.Id</strong>
                                                }
                                            </td>
                                            <td>@task.Request.FormDefinition?.Name</td>
                                            <td>@task.StepName</td>
                                            <td>
                                                <span class="badge bg-@(GetRequestTypeBadgeColor(task.Request.RequestType))">
                                                    @task.Request.RequestType
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(task.Request.Status)">@task.Request.Status</span>
                                            </td>
                                            <td>@task.Request.RequestedByName</td>
                                            <td>
                                                <small>@Tz.FormatDate(task.Request.RequestedAt)</small>
                                            </td>
                                            <td class="col-actions">
                                                <button class="btn btn-sm btn-outline-primary" title="Review" aria-label="Review request"
                                                        @onclick="() => ViewApprovalTask(task)">
                                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer">
                            <TablePagination CurrentPage="_currentPage" TotalPages="_totalPages" PageSize="_pageSize" TotalCount="_totalCount"
                                             AriaLabel="Approvals pagination" OnPageChanged="ChangePage" OnPageSizeChanged="OnPageSizeChanged" />
                        </div>
                    }
            </div>

@code {
    private List<WorkflowApprovalTask> AllTasks = new();
    private List<WorkflowApprovalTask> FilteredTasks = new();
    private bool IsLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalCount = 0;
    private int _totalPages = 0;
    private List<FormDefinition> _availableForms = new();
    private string SelectedFormFilter = "";
    private string SelectedStatusFilter = "InProgress";
    private string SortOrder = "newest";
    private string? SuccessMessage;
    private string? ErrorMessage;
    private ClaimsPrincipal? User;
    private List<string> UserRoles = new();

    private string GetEmptyStateDescription() => 
        string.IsNullOrEmpty(SelectedFormFilter) 
            ? "All approvals have been processed." 
            : "No requests match your current filters.";

    protected override async Task OnInitializedAsync()
    {
        await GetUserInfo();
        _availableForms = await FormDefinitionService.GetActiveAsync();
        await LoadData();
    }

    private async Task GetUserInfo()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        User = authState.User;
        
        if (User?.Identity?.IsAuthenticated == true)
        {
            UserRoles = User.Claims
                .Where(c => c.Type == "roles" || 
                           c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" ||
                           c.Type == ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();
        }
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            ClearMessages();

            if (User?.Identity?.IsAuthenticated == true)
            {
                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
                
                Logger.LogInformation("WorkflowApprovals: Loading page {Page} (size {PageSize}) for user {UserName}", _currentPage, _pageSize, User.Identity.Name);

                int? formFilter = !string.IsNullOrEmpty(SelectedFormFilter) && int.TryParse(SelectedFormFilter, out var fid) ? fid : null;

                var (tasks, totalCount) = await FormRequestQueryService.GetForWorkflowApprovalPagedAsync(
                    userId, UserRoles, _currentPage, _pageSize, formFilter, SelectedStatusFilter, SortOrder);

                _totalCount = totalCount;
                _totalPages = (int)Math.Ceiling((double)totalCount / _pageSize);

                AllTasks = tasks;
                FilteredTasks = AllTasks;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading approvals: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadData();
    }

    private void ViewApprovalTask(WorkflowApprovalTask task)
    {
        try
        {
            var request = task.Request;
            
            if (request.WorkflowInstanceId.HasValue)
            {
                var workflowUrl = $"/workflow/{request.WorkflowInstanceId}/step/{task.StepId}";
                Logger.LogInformation("Navigating to approval step URL: {WorkflowUrl}", workflowUrl);
                Navigation.NavigateTo(workflowUrl);
            }
            else
            {
                var fallbackUrl = request.BulkFormRequestId.HasValue
                    ? $"/bulk-requests/{request.BulkFormRequestId}"
                    : $"/requests/{request.Id}";
                Logger.LogInformation("No workflow instance, using fallback URL: {FallbackUrl}", fallbackUrl);
                Navigation.NavigateTo(fallbackUrl);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in ViewApprovalTask for requestId: {RequestId}", task.Request.Id);
            Navigation.NavigateTo($"/requests/{task.Request.Id}");
        }
    }

    private string GetRequestTypeBadgeColor(RequestType requestType) => UiHelper.GetRequestTypeColor(requestType);
    private string GetStatusBadgeClass(RequestStatus status) => UiHelper.GetStatusBadgeClass(status);

    private void ClearMessages()
    {
        SuccessMessage = null;
        ErrorMessage = null;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(SelectedFormFilter) || SelectedStatusFilter != "InProgress" || SortOrder != "newest";

    private async Task ClearFilters()
    {
        SelectedFormFilter = "";
        SelectedStatusFilter = "InProgress";
        SortOrder = "newest";
        await ApplyFilters();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        await LoadData();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _currentPage = 1;
        await LoadData();
    }
}
