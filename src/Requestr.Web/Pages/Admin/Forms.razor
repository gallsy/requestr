@page "/admin/forms"
@using Requestr.Core.Models
@using Requestr.Core.Interfaces
@inject IFormDefinitionService FormDefinitionService
@inject IFormDesignService FormDesignService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastNotificationService toastService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Authorize]

@inject Requestr.Web.Configuration.AppBrandingOptions Branding
@inject IUserTimezoneService Tz
<PageTitle>Form Management | @Branding.ApplicationName</PageTitle>

<PageHeader Title="Manage Forms" Description="Create and maintain request forms">
    <Actions>
        @if (_isAdmin)
        {
        <button class="btn btn-primary" @onclick="CreateForm" title="Create New Form">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New Form
        </button>
        }
    </Actions>
</PageHeader>

    @if (_isLoading)
    {
        <LoadingSpinner Message="Loading forms..." />
    }
    else if (!_forms.Any())
    {
        <EmptyState Title="No Forms Available" 
                    Description="@(!_isAdmin ? "No editable forms found." : "No forms found.")">
            <Action>
                @if (_isAdmin)
                {
                <Button Color="ButtonColor.Primary" @onclick="CreateForm">
                    <Icon Name="IconName.Plus" class="me-2" />
                    Create New Form
                </Button>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <FilterBar Summary="@($"{_filteredForms.Count} of {_forms.Count} forms")" ShowClear="HasActiveFilters" OnClear="ClearFilters">
            <select class="form-select form-select-sm" aria-label="Status" @bind="StatusFilter" @bind:after="ApplyFilter">
                <option value="all">All Statuses</option>
                <option value="active">Active Only</option>
                <option value="inactive">Inactive Only</option>
            </select>
            <select class="form-select form-select-sm" aria-label="Category" @bind="CategoryFilter" @bind:after="ApplyFilter">
                <option value="">All Categories</option>
                @foreach (var cat in _allCategories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
            @if (_isAdmin)
            {
                <select class="form-select form-select-sm" aria-label="Role" @bind="RoleFilter" @bind:after="ApplyFilter">
                    <option value="">All Roles</option>
                    @foreach (var role in _allRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            }
        </FilterBar>
        @if (!_filteredForms.Any())
        {
            <EmptyState Title="No Matching Forms" Icon="bi-funnel" Description="No forms match your current filters." />
        }
        else
        {
        <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Category</th>
                                @if (_isAdmin)
                                {
                                    <th>Roles</th>
                                }
                                <th>Status</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var form in _filteredForms)
                            {
                                <tr>
                                    <td>
                                        <strong>@form.Name</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(form.Description))
                                        {
                                            <span title="@form.Description">
                                                @(form.Description.Length > 50 ? form.Description.Substring(0, 47) + "..." : form.Description)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(form.Category))
                                        {
                                            <span class="badge bg-light text-dark border">@form.Category</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">&mdash;</span>
                                        }
                                    </td>
                                    @if (_isAdmin)
                                    {
                                    <td>
                                        @{
                                            var roles = form.FormPermissions
                                                .Where(p => p.IsGranted)
                                                .Select(p => p.RoleName)
                                                .Distinct()
                                                .OrderBy(r => r)
                                                .ToList();
                                        }
                                        @if (roles.Any())
                                        {
                                            @foreach (var role in roles)
                                            {
                                                <span class="badge bg-secondary me-1 mb-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No roles</span>
                                        }
                                    </td>
                                    }
                                    <td>
                                        @if (form.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="col-actions">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Form actions">
                                            <button class="btn btn-outline-primary" @onclick="() => EditForm(form.Id)" title="Edit form" aria-label="Edit form">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </button>
                                            @if (_isAdmin)
                                            {
                                            <button class="btn btn-outline-primary" @onclick="() => ViewForm(form.Id)" title="Open form" aria-label="Open form">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                            <button class="btn btn-outline-warning" @onclick="() => ToggleFormStatus(form)"
                                                    title="@(form.IsActive ? "Deactivate form" : "Activate form")" aria-label="@(form.IsActive ? "Deactivate form" : "Activate form")">
                                                <i class="bi @(form.IsActive ? "bi-pause-fill" : "bi-play-fill")" aria-hidden="true"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => DeleteForm(form.Id)" title="Delete form" aria-label="Delete form">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        </div>
        }
    }

@code {
    private List<FormDefinition> _forms = new();
    private List<FormDefinition> _filteredForms = new();
    private List<string> _allCategories = new();
    private List<string> _allRoles = new();
    private bool _isLoading = true;
    private bool _isAdmin;
    private string StatusFilter = "all";
    private string CategoryFilter = "";
    private string RoleFilter = "";

    private bool HasActiveFilters => StatusFilter != "all" || !string.IsNullOrEmpty(CategoryFilter) || !string.IsNullOrEmpty(RoleFilter);

    private void ClearFilters()
    {
        StatusFilter = "all";
        CategoryFilter = "";
        RoleFilter = "";
        ApplyFilter();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadForms();
    }

    private async Task LoadForms()
    {
        try
        {
            _isLoading = true;
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _isAdmin = user.Identity?.IsAuthenticated == true && ClaimsHelper.GetUserRoles(user).Contains("Admin");
            _forms = _isAdmin
                ? await FormDefinitionService.GetFormDefinitionsAsync()
                : await FormDesignService.GetEditableFormsAsync(user);
            _allCategories = _forms
                .Where(f => !string.IsNullOrEmpty(f.Category))
                .Select(f => f.Category)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
            _allRoles = _forms
                .SelectMany(f => f.FormPermissions)
                .Where(p => p.IsGranted)
                .Select(p => p.RoleName)
                .Distinct()
                .OrderBy(r => r)
                .ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error loading forms: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyFilter()
    {
        var query = _forms.AsEnumerable();

        query = StatusFilter switch
        {
            "active" => query.Where(f => f.IsActive),
            "inactive" => query.Where(f => !f.IsActive),
            _ => query
        };

        if (!string.IsNullOrEmpty(CategoryFilter))
        {
            query = query.Where(f => string.Equals(f.Category, CategoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (_isAdmin && !string.IsNullOrEmpty(RoleFilter))
        {
            query = query.Where(f => f.FormPermissions
                .Any(p => p.IsGranted && string.Equals(p.RoleName, RoleFilter, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredForms = query.ToList();
    }

    private void CreateForm()
    {
        if (!_isAdmin) return;
        Navigation.NavigateTo("/admin/forms/builder");
    }

    private void EditForm(int formId)
    {
        Navigation.NavigateTo($"/admin/forms/builder/{formId}");
    }

    private void ViewForm(int formId)
    {
        Navigation.NavigateTo($"/forms/{formId}");
    }

    private async Task ToggleFormStatus(FormDefinition form)
    {
        try
        {
            if (!await HasAdminAccessAsync()) return;
            var current = await FormDefinitionService.GetByIdAsync(form.Id);
            if (current == null) return;
            current.IsActive = !current.IsActive;
            await FormDefinitionService.UpdateFormDefinitionAsync(current);
            form.IsActive = current.IsActive;
            ApplyFilter(); // Refresh the filtered list
            StateHasChanged();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error updating form status: {ex.Message}");
            ApplyFilter(); // Refresh the filtered list
        }
    }

    private async Task DeleteForm(int formId)
    {
        if (!await HasAdminAccessAsync()) return;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this form? This action cannot be undone.");
        if (confirmed)
        {
            try
            {
                if (!await HasAdminAccessAsync()) return;
                await FormDefinitionService.DeleteFormDefinitionAsync(formId);
                await LoadForms();
            }
            catch (Exception ex)
            {
                toastService.ShowError($"Error deleting form: {ex.Message}");
            }
        }
    }

    private async Task<bool> HasAdminAccessAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var allowed = user.Identity?.IsAuthenticated == true && ClaimsHelper.GetUserRoles(user).Contains("Admin");
        if (!allowed) toastService.ShowError("Admin access is required for this action.");
        return allowed;
    }
}
