@page "/requests"
@using Requestr.Core.Models
@using Requestr.Core.Models.DTOs
@using Requestr.Core.Interfaces
@using Requestr.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Requestr.Web.Components
@attribute [Authorize]
@inject IFormRequestQueryService FormRequestQueryService
@inject IFormDefinitionService FormDefinitionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<AllRequests> Logger

@inject Requestr.Web.Configuration.AppBrandingOptions Branding
@inject IUserTimezoneService Tz
<PageTitle>All Requests | @Branding.ApplicationName</PageTitle>

<PageHeader Title="All Requests" Description="@($"View and manage {(_isAdmin ? "all" : "your accessible")} data requests")" />

    <FilterBar ShowClear="HasActiveFilters()" OnClear="ClearFilters">
        @if (_isAdmin)
        {
            <div class="input-group input-group-sm filter-bar-search">
                <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                <input type="text" class="form-control" aria-label="Requested by" placeholder="Requested by..."
                       @bind="RequestedByFilter" @bind:after="ApplyFilters">
            </div>
        }
        <select class="form-select form-select-sm" aria-label="Status" @bind="SelectedStatusFilter" @bind:after="ApplyFilters">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
            <option value="Applied">Applied</option>
            <option value="Failed">Failed</option>
        </select>
        <select class="form-select form-select-sm" aria-label="Form" @bind="SelectedFormFilter" @bind:after="ApplyFilters">
            <option value="">All Forms</option>
            @if (AvailableForms?.Any() == true)
            {
                @foreach (var form in AvailableForms)
                {
                    <option value="@form">@form</option>
                }
            }
        </select>
        <select class="form-select form-select-sm" aria-label="Operation" @bind="SelectedOperationTypeFilter" @bind:after="ApplyFilters">
            <option value="">All Operations</option>
            <option value="Insert">Insert</option>
            <option value="Update">Update</option>
            <option value="Delete">Delete</option>
        </select>
        <select class="form-select form-select-sm" aria-label="Individual or bulk" @bind="SelectedRequestTypeFilter" @bind:after="ApplyFilters">
            <option value="">Individual &amp; Bulk</option>
            <option value="Individual">Individual Only</option>
            <option value="Bulk">Bulk Only</option>
        </select>
        @if (!_isAdmin)
        {
            <select class="form-select form-select-sm" aria-label="Request source" @bind="SelectedSourceFilter" @bind:after="ApplyFilters">
                <option value="">All Sources</option>
                <option value="MyRequests">My Requests</option>
                <option value="ForApproval">For My Approval</option>
            </select>
        }
        <select class="form-select form-select-sm" aria-label="Date range" @bind="SelectedDateRangeFilter" @bind:after="ApplyFilters">
            <option value="">All Time</option>
            <option value="Today">Today</option>
            <option value="Yesterday">Yesterday</option>
            <option value="ThisWeek">This Week</option>
            <option value="LastWeek">Last Week</option>
            <option value="ThisMonth">This Month</option>
            <option value="LastMonth">Last Month</option>
            <option value="Last3Months">Last 3 Months</option>
        </select>
    </FilterBar>

            @if (IsLoading)
            {
                <LoadingSpinner Message="Loading requests..." />
            }
            else if (_pagedItems?.Any() != true)
            {
                <EmptyState Title="No requests found" 
                            Description="@(HasActiveFilters() ? "No requests match your current filters. Try adjusting your filter criteria." : _isAdmin ? "No requests have been made yet." : "You haven't made any requests yet or don't have access to approve any requests.")">
                    <Action>
                        <a href="/forms" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-2"></i>
                            Create New Request
                        </a>
                    </Action>
                </EmptyState>
            }
            else
            {
                <div class="card">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Form</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Requested By</th>
                                        <th>Date</th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _pagedItems)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@item.Id@(item.IsBulk ? "-Bulk" : "")</strong>
                                            </td>
                                            <td>@item.FormName</td>
                                            <td>
                                                <span class="badge @GetRequestTypeBadgeColor(item.RequestType)">
                                                    @GetRequestTypeDisplayName(item.RequestType)
                                                </span>
                                                @if (item.IsBulk && item.BulkRowCount.HasValue)
                                                {
                                                    <small class="text-muted ms-1">@item.BulkRowCount rows</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(item.Status)">@item.Status</span>
                                            </td>
                                            <td>@item.RequestedByName</td>
                                            <td>
                                                <small>@Tz.FormatDate(item.RequestedAt)</small>
                                            </td>
                                            <td class="col-actions">
                                                @if (item.IsBulk)
                                                {
                                                    <a href="/bulk-requests/@item.Id" class="btn btn-sm btn-outline-primary" title="View request" aria-label="View request @item.Id">
                                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="/requests/@item.Id" class="btn btn-sm btn-outline-primary" title="View request" aria-label="View request @item.Id">
                                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer">
                            <TablePagination CurrentPage="_currentPage" TotalPages="_totalPages" PageSize="_pageSize" TotalCount="_totalCount"
                                             AriaLabel="Requests pagination" OnPageChanged="ChangePage" OnPageSizeChanged="OnPageSizeChanged" />
                        </div>
                </div>
            }

@code {
    private List<UnifiedRequestListItem>? _pagedItems;
    private string? CurrentUserId;
    private List<string> UserRoles = new();
    private bool IsLoading = true;
    private bool _isAdmin = false;
    
    // Filter properties
    private string SelectedStatusFilter = "";
    private string SelectedRequestTypeFilter = "";
    private string SelectedOperationTypeFilter = "";
    private string SelectedFormFilter = "";
    private string SelectedSourceFilter = "";
    private string SelectedDateRangeFilter = "";
    private string RequestedByFilter = "";
    
    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 0;
    private int _totalCount = 0;
    
    // Available options for filters
    private List<string> AvailableForms = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                CurrentUserId = UserIdentityHelper.GetUserId(authState.User);
                UserRoles = ClaimsHelper.GetUserRoles(authState.User);
                _isAdmin = UserRoles.Contains("Admin");

                // Load form names for filter dropdown
                var forms = await FormDefinitionService.GetFormDefinitionsForUserAsync(CurrentUserId, UserRoles);
                AvailableForms = forms.Select(f => f.Name).Distinct().OrderBy(n => n).ToList();

                await LoadPageAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading all requests");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadPageAsync()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;

        try
        {
            _currentPage = Math.Max(1, _currentPage);

            async Task<(List<UnifiedRequestListItem> Items, int TotalCount)> GetPageAsync(int page) =>
                await FormRequestQueryService.GetAccessibleRequestsPagedAsync(
                    CurrentUserId, UserRoles, page, _pageSize,
                    statusFilter: string.IsNullOrEmpty(SelectedStatusFilter) ? null : SelectedStatusFilter,
                    operationTypeFilter: string.IsNullOrEmpty(SelectedOperationTypeFilter) ? null : SelectedOperationTypeFilter,
                    formFilter: string.IsNullOrEmpty(SelectedFormFilter) ? null : SelectedFormFilter,
                    requestTypeFilter: string.IsNullOrEmpty(SelectedRequestTypeFilter) ? null : SelectedRequestTypeFilter,
                    sourceFilter: string.IsNullOrEmpty(SelectedSourceFilter) ? null : SelectedSourceFilter,
                    dateRangeFilter: string.IsNullOrEmpty(SelectedDateRangeFilter) ? null : SelectedDateRangeFilter,
                    requestedByFilter: string.IsNullOrEmpty(RequestedByFilter) ? null : RequestedByFilter,
                    sortOrder: "newest");

            void UpdatePaginationTotals(int count)
            {
                _totalCount = count;
                _totalPages = Math.Max(1, (int)Math.Ceiling((double)count / _pageSize));
            }

            var (items, totalCount) = await GetPageAsync(_currentPage);
            UpdatePaginationTotals(totalCount);

            if (totalCount > 0 && _currentPage > _totalPages)
            {
                _currentPage = _totalPages;
                (items, totalCount) = await GetPageAsync(_currentPage);
                UpdatePaginationTotals(totalCount);
            }

            _pagedItems = items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading requests page");
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        IsLoading = true;
        StateHasChanged();
        try
        {
            await LoadPageAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        await LoadPageAsync();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        await LoadPageAsync();
    }

    private async Task ClearFilters()
    {
        SelectedStatusFilter = "";
        SelectedRequestTypeFilter = "";
        SelectedOperationTypeFilter = "";
        SelectedFormFilter = "";
        SelectedSourceFilter = "";
        SelectedDateRangeFilter = "";
        RequestedByFilter = "";
        _currentPage = 1;
        await LoadPageAsync();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(SelectedStatusFilter) ||
               !string.IsNullOrEmpty(SelectedRequestTypeFilter) ||
               !string.IsNullOrEmpty(SelectedOperationTypeFilter) ||
               !string.IsNullOrEmpty(SelectedFormFilter) ||
               !string.IsNullOrEmpty(SelectedSourceFilter) ||
               !string.IsNullOrEmpty(SelectedDateRangeFilter) ||
               !string.IsNullOrEmpty(RequestedByFilter);
    }

    private string GetStatusBadgeClass(RequestStatus status) => UiHelper.GetStatusBadgeClass(status);
    private string GetRequestTypeBadgeColor(RequestType requestType) => UiHelper.GetRequestTypeBadgeClass(requestType);

    private string GetRequestTypeDisplayName(RequestType requestType) => requestType switch
    {
        RequestType.Insert => "Add New Record",
        RequestType.Update => "Update Record",
        RequestType.Delete => "Delete Record",
        _ => "Unknown"
    };
}
