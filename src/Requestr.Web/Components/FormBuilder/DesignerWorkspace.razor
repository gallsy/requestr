@using Requestr.Core.Models
@using Requestr.Core.Utilities
@using Requestr.Web.Utilities
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="designer-workspace" @ref="_root" data-presentation-only="@PresentationOnly.ToString().ToLowerInvariant()">
    <aside class="designer-outline" aria-label="Form outline">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h6 mb-0">Outline</h2>
            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddSection" title="Add section" aria-label="Add section"><i class="bi bi-plus-lg"></i></button>
        </div>
        @foreach (var section in Form.Sections.OrderBy(section => section.DisplayOrder))
        {
            <button type="button" class="outline-item @(_section == section && _field == null ? "selected" : "")" @onclick="() => SelectSection(section)">
                <i class="bi bi-layout-text-window me-2"></i>@(section.Name)
            </button>
            @foreach (var field in Form.Fields.Where(field => field.FormSectionId == section.Id).OrderBy(field => field.GridRow).ThenBy(field => field.GridColumn))
            {
                <button type="button" class="outline-item outline-field @(_field == field ? "selected" : "")" @onclick="() => SelectField(field)">@field.DisplayName</button>
            }
        }
        @foreach (var field in Form.Fields.Where(field => !Form.Sections.Any(section => section.Id == field.FormSectionId)))
        {
            <button type="button" class="outline-item @(_field == field ? "selected" : "")" @onclick="() => SelectField(field)">@field.DisplayName</button>
        }
        @if (!PresentationOnly)
        {
            <h2 class="h6 mt-4">Available Fields</h2>
            <input class="form-control form-control-sm mb-2" placeholder="Search fields" aria-label="Search available fields" @bind="_search" @bind:event="oninput" />
            <small class="text-muted">@Columns.Count(column => !Form.Fields.Any(field => field.Name == column.Name)) available</small>
            @foreach (var column in Columns.Where(column => !Form.Fields.Any(field => field.Name == column.Name) && (column.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || column.DataType.Contains(_search, StringComparison.OrdinalIgnoreCase))))
            {
                <div class="available-field">
                    <button class="grid-handle" type="button" data-grid-action="add" data-field-name="@column.Name" title="Drag field onto grid" aria-label="@($"Drag {column.Name} onto grid")"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button>
                    <button class="outline-item" type="button" @onclick="() => AddField(column)" title="Add to selected section"><i class="bi bi-plus me-2"></i>@column.Name
                        <small class="d-block text-muted">@column.DataType @(column.IsPrimaryKey ? "PK" : "") @(column.IsIdentity ? "Identity" : "") @(column.IsNullable ? "Optional" : "Required")</small>
                    </button>
                </div>
            }
        }
    </aside>
    <main class="designer-canvas" aria-label="Form layout">
        <h2 class="h5 mb-4">@Form.Name</h2>
        @foreach (var section in Form.Sections.OrderBy(section => section.DisplayOrder))
        {
            <section class="canvas-section @(_section == section ? "active-section" : "")">
                <button type="button" class="section-heading" @onclick="() => SelectSection(section)">
                    <span>@(section.Name)</span>
                    @if (!string.IsNullOrWhiteSpace(section.VisibilityCondition)) { <i class="bi bi-signpost-split" title="Conditional section"></i> }
                </button>
                @if (!string.IsNullOrWhiteSpace(section.Description)) { <p class="small text-muted">@(section.Description)</p> }
                <div class="canvas-fields" data-section-id="@(section.Id)" data-columns="@(section.MaxColumns)" data-condition="@(section.VisibilityCondition ?? "")"
                     style="grid-template-columns: repeat(@(section.MaxColumns), minmax(0, 1fr)); grid-template-rows: repeat(@Math.Min(1000, DesignerGrid.NextRow(Form, section)), minmax(128px, auto));">
                    @foreach (var field in Form.Fields.Where(field => field.FormSectionId == section.Id).OrderBy(field => field.GridRow).ThenBy(field => field.GridColumn))
                    {
                        var issue = GetFieldIssue?.Invoke(field);
                        <div @key="field.Name" class="canvas-field @(_field == field ? "selected" : "") @(!string.IsNullOrEmpty(issue) ? "schema-issue" : "")"
                             data-field-name="@field.Name" data-row="@field.GridRow" data-column="@field.GridColumn" data-span="@field.GridColumnSpan"
                             style="grid-row: @field.GridRow; grid-column: @field.GridColumn / span @field.GridColumnSpan;" @onclick="() => SelectField(field)">
                            <button type="button" class="grid-handle field-drag-handle" data-grid-action="move" title="Move field" aria-label="@($"Move {field.DisplayName}")"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button>
                            <button type="button" class="field-select" @onclick="() => SelectField(field)" aria-pressed="@(_field == field)">
                            <span class="d-flex justify-content-between gap-2"><span>@field.DisplayName @if (field.IsRequired) { <span class="text-danger">*</span> }</span>
                                @if (!string.IsNullOrEmpty(field.VisibilityCondition) || !string.IsNullOrEmpty(field.LookupParentField)) { <i class="bi bi-signpost-split" title="Conditional field"></i> }
                                @if (!string.IsNullOrEmpty(issue)) { <i class="bi bi-exclamation-triangle text-warning" title="@issue" aria-label="@issue"></i> }
                            </span>
                            <span class="field-preview" aria-hidden="true">
                                @if (field.ControlType == "checkbox") { <i class="bi bi-square"></i> }
                                else { <span class="text-muted">@(field.DefaultValue ?? " ")</span><i class="bi @(field.ControlType is "select" or "searchable-select" ? "bi-chevron-down" : "bi-input-cursor-text")"></i> }
                            </span>
                            </button>
                            <button type="button" class="grid-handle field-resize-handle" data-grid-action="resize" title="Resize field width" aria-label="@($"Resize {field.DisplayName}")"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></button>
                        </div>
                    }
                </div>
                @if (!Form.Fields.Any(field => field.FormSectionId == section.Id)) { <div class="empty-section text-muted">No fields</div> }
            </section>
        }
    </main>
    <aside class="designer-properties" aria-label="Properties">
        @if (_field != null)
        {
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div><h2 class="h6 mb-1">@_field.DisplayName</h2><small class="text-muted">@_field.Name</small></div>
                @if (!PresentationOnly) { <button class="btn btn-sm btn-outline-danger" type="button" title="Remove field" aria-label="Remove field" @onclick="RemoveField"><i class="bi bi-trash"></i></button> }
            </div>
            <h3 class="h6 border-bottom pb-2 mb-3">Layout</h3>
            @if (!string.IsNullOrEmpty(GetFieldIssue?.Invoke(_field))) { <div class="small text-warning mb-2">@GetFieldIssue(_field)</div> }
            <label class="form-label">Section</label>
            <select @key="(_positionVersion.ToString() + nameof(MoveSection))" class="form-select mb-2" value="@_field.FormSectionId" @onchange="MoveSection" aria-label="Field section">
                @if (_section == null) { <option value="">Unsectioned</option> }
                @foreach (var section in Form.Sections.Where(section => !PresentationOnly || (section.VisibilityCondition ?? "") == (_section?.VisibilityCondition ?? ""))) { <option value="@(section.Id)">@(section.Name)</option> }
            </select>
            @if (_section != null)
            {
                <div class="row g-2 mb-2" @key="_positionVersion">
                    <div class="col-6"><label class="form-label">Row</label><input class="form-control" type="number" min="1" max="1000" value="@_field.GridRow" @onchange="args => ChangePosition(args, true)" aria-label="Field row" /></div>
                    <div class="col-6"><label class="form-label">Column</label><input class="form-control" type="number" min="1" max="@_section.MaxColumns" value="@_field.GridColumn" @onchange="args => ChangePosition(args, false)" aria-label="Field column" /></div>
                </div>
                <div class="btn-group mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => MoveField(-1)" title="Move field up" aria-label="Move field up"><i class="bi bi-arrow-up"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => MoveField(1)" title="Move field down" aria-label="Move field down"><i class="bi bi-arrow-down"></i></button>
                </div>
            }
            <label class="form-label">Width</label>
            <select @key="(_positionVersion.ToString() + nameof(ChangeWidth))" class="form-select mb-2" value="@_field.GridColumnSpan" @onchange="ChangeWidth" aria-label="Field width">
                @for (var span = 1; span <= (_section?.MaxColumns ?? 12); span++) { <option value="@span">@span</option> }
            </select>
            <FieldConfigurationModal @key="_field" Inline="true" Field="_field" Fields="Form.Fields" Sections="Form.Sections" PresentationOnly="PresentationOnly"
                DatabaseConnectionName="@Form.DatabaseConnectionName" SqlType="@(_field.SqlDataType ?? _field.DataType)"
                ColumnInfo="@Columns.FirstOrDefault(column => column.Name == _field.Name)" OnChanged="OnChanged" />
        }
        else if (_section != null)
        {
            <h2 class="h6 mb-3">Section Properties</h2>
            <h3 class="h6 border-bottom pb-2 mb-3">Content</h3>
            <label class="form-label">Title</label><input class="form-control mb-3" @bind="_section.Name" @bind:after="Changed" />
            <label class="form-label">Description</label><textarea class="form-control mb-3" rows="3" @bind="_section.Description" @bind:after="Changed"></textarea>
            <h3 class="h6 border-bottom pb-2 mt-4 mb-3">Layout</h3>
            <label class="form-label">Columns</label>
            <select class="form-select mb-3" value="@_section.MaxColumns" @onchange="ChangeColumns" aria-label="Section columns">
                @foreach (var count in new[] { 1, 2, 3, 4, 6, 12 }) { <option value="@count" disabled="@(!DesignerGrid.CanSetColumns(Form, _section, count))">@count</option> }
            </select>
            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" @onclick="Reflow"><i class="bi bi-grid me-1" aria-hidden="true"></i>Auto-arrange</button>
            <label class="form-label">Order</label><input class="form-control mb-3" type="number" min="1" @bind="_section.DisplayOrder" @bind:after="Changed" />
            @if (!PresentationOnly) { <ConditionEditor Fields="Form.Fields" ExcludedSection="_section.Id" @bind-Value="_section.VisibilityCondition" @bind-Value:after="Changed" /> }
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RemoveSection" disabled="@(PresentationOnly && !string.IsNullOrWhiteSpace(_section.VisibilityCondition))"><i class="bi bi-trash me-1"></i>Remove section</button>
        }
        else { <h2 class="h6">Properties</h2><span class="text-muted small">No selection</span> }
        <div class="small text-muted mt-2" role="status">@_placementStatus</div>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public FormDefinition Form { get; set; } = default!;
    [Parameter] public List<ColumnInfo> Columns { get; set; } = new();
    [Parameter] public bool PresentationOnly { get; set; }
    [Parameter] public EventCallback<ColumnInfo> OnAddField { get; set; }
    [Parameter] public EventCallback OnAddSection { get; set; }
    [Parameter] public EventCallback<FormField> OnRemoveField { get; set; }
    [Parameter] public EventCallback<FormSection> OnRemoveSection { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public Func<FormField, string>? GetFieldIssue { get; set; }
    private ElementReference _root;
    private DotNetObjectReference<DesignerWorkspace>? _interop;
    private int _positionVersion;
    private string? _placementStatus;
    private FormField? _field;
    private FormSection? _section;
    private string _search = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _interop = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("designerGrid.initialize", _root, _interop);
    }

    public async ValueTask DisposeAsync()
    {
        if (_interop == null) return;
        try { await JSRuntime.InvokeVoidAsync("designerGrid.dispose", _root); }
        catch (JSDisconnectedException) { }
        _interop?.Dispose();
    }

    [JSInvokable]
    public async Task<bool> CommitPlacement(string name, int sectionId, int row, int column, int span, bool adding)
    {
        var section = Form.Sections.FirstOrDefault(candidate => candidate.Id == sectionId);
        if (section == null) return false;
        var field = Form.Fields.FirstOrDefault(candidate => candidate.Name == name);
        if (adding)
        {
            var source = Columns.FirstOrDefault(candidate => candidate.Name == name);
            if (PresentationOnly || field != null || source == null || !DesignerGrid.CanPlace(Form, null, section, row, column, span, false)) return false;
            await OnAddField.InvokeAsync(source);
            field = Form.Fields.FirstOrDefault(candidate => candidate.Name == name);
        }
        if (field == null) return false;
        var accepted = DesignerGrid.TryPlace(Form, field, section, row, column, span, PresentationOnly);
        _placementStatus = accepted ? null : "That position is unavailable.";
        _positionVersion++;
        if (accepted) { SelectField(field); await Changed(); }
        await InvokeAsync(StateHasChanged);
        return accepted;
    }

    protected override void OnParametersSet()
    {
        if (_field != null && !Form.Fields.Contains(_field))
        {
            _field = Form.Fields.FirstOrDefault(field => field.Name == _field.Name);
        }
        if (_field != null) _section = Form.Sections.FirstOrDefault(section => section.Id == _field.FormSectionId);
        else if (_section == null || !Form.Sections.Contains(_section))
            _section = Form.Sections.FirstOrDefault(section => section.Id == _section?.Id) ?? Form.Sections.OrderBy(section => section.DisplayOrder).FirstOrDefault();
    }
    private void SelectField(FormField field) { _field = field; _section = Form.Sections.FirstOrDefault(section => section.Id == field.FormSectionId); }
    private void SelectSection(FormSection section) { _section = section; _field = null; }
    private Task Changed() => OnChanged.InvokeAsync();
    private async Task AddSection() { await OnAddSection.InvokeAsync(); SelectSection(Form.Sections.Last()); await Changed(); }
    private async Task AddField(ColumnInfo column)
    {
        if (PresentationOnly || Form.Fields.Any(field => field.Name == column.Name)) return;
        var target = _section;
        if (target != null && DesignerGrid.NextRow(Form, target) > 1000) return;
        await OnAddField.InvokeAsync(column);
        var added = Form.Fields.LastOrDefault(field => field.Name == column.Name);
        if (added == null) return;
        if (target != null) { added.FormSectionId = target.Id; added.GridRow = Form.Fields.Where(field => field != added && field.FormSectionId == target.Id).Select(field => field.GridRow).DefaultIfEmpty(0).Max() + 1; added.GridColumn = 1; added.GridColumnSpan = target.MaxColumns; }
        SelectField(added);
        await Changed();
    }
    private async Task RemoveField() { if (_field == null) return; await OnRemoveField.InvokeAsync(_field); _field = null; await Changed(); }
    private async Task RemoveSection() { if (_section == null) return; await OnRemoveSection.InvokeAsync(_section); _section = Form.Sections.FirstOrDefault(); _field = null; await Changed(); }
    private async Task MoveSection(ChangeEventArgs args)
    {
        if (_field == null || !int.TryParse(args.Value?.ToString(), out var id)) return;
        var section = Form.Sections.FirstOrDefault(section => section.Id == id);
        if (section == null || section == _section) return;
        await CommitPlacement(_field.Name, id, DesignerGrid.NextRow(Form, section), 1, _field.GridColumnSpan, false);
    }
    private async Task ChangePosition(ChangeEventArgs args, bool row)
    {
        if (_field == null || _section == null || !int.TryParse(args.Value?.ToString(), out var value)) { _positionVersion++; return; }
        await CommitPlacement(_field.Name, _section.Id, row ? value : _field.GridRow, row ? _field.GridColumn : value, _field.GridColumnSpan, false);
    }
    private async Task ChangeWidth(ChangeEventArgs args)
    {
        if (_field == null || !int.TryParse(args.Value?.ToString(), out var value)) return;
        if (_section == null)
        {
            if (value is < 1 or > 12) return;
            _field.GridColumnSpan = value;
            await Changed();
            return;
        }
        await CommitPlacement(_field.Name, _section.Id, _field.GridRow, _field.GridColumn, value, false);
    }
    private async Task MoveField(int direction)
    {
        if (_field == null || _section == null) return;
        await CommitPlacement(_field.Name, _section.Id, _field.GridRow + direction, _field.GridColumn, _field.GridColumnSpan, false);
    }
    private async Task ChangeColumns(ChangeEventArgs args)
    {
        if (_section == null || !int.TryParse(args.Value?.ToString(), out var count) || !DesignerGrid.CanSetColumns(Form, _section, count)) return;
        _section.MaxColumns = count;
        await Changed();
    }
    private async Task Reflow()
    {
        if (_section == null || !DesignerGrid.Arrange(Form, _section)) return;
        _placementStatus = null;
        await Changed();
    }
}