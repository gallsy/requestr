@* Field Configuration Modal Component *@
@using Requestr.Core.Models
@using BlazorBootstrap

@if (Inline)
{
    <div class="field-properties" @onchange="NotifyChanged" @oninput="NotifyChanged">@Properties</div>
}
else
{
    <Modal @ref="_modal" Title="@ModalTitle" Size="ModalSize.Large">
        <BodyTemplate>@Properties</BodyTemplate>
        <FooterTemplate><Button Color="ButtonColor.Secondary" @onclick="CloseAsync">Close</Button></FooterTemplate>
    </Modal>
}

@code {
    private RenderFragment Properties => @<div>
        @if (Field != null)
        {
            @if (Inline) { <h3 class="h6 border-bottom pb-2 mb-3">Control</h3> }
            <div class="row mb-2">
                <div class="col-md-6">
                    <label class="form-label">Field Name</label>
                    <input type="text" class="form-control" @bind="Field.DisplayName" @bind:after="NotifyChanged" />
                </div>
                @if (!PresentationOnly)
                {
                <div class="col-md-6">
                    <label class="form-label">Control Type</label>
                    <select class="form-select" @bind="Field.ControlType" @bind:after="OnControlTypeChanged">
                        @foreach (var controlOption in AvailableControlTypes)
                        {
                            <option value="@controlOption.Value">@controlOption.Text</option>
                        }
                    </select>
                    <small class="form-text text-muted">SQL Type: @SqlType</small>
                </div>
                }
            </div>
            @if (!PresentationOnly)
            {
            @if (Inline) { <h3 class="h6 border-bottom pb-2 mt-4 mb-3">Defaults and Validation</h3> }
            <div class="row mb-2">
                <div class="col-md-6">
                    @if (HasComputedValue)
                    {
                        <label class="form-label">Default Value</label>
                        <input type="text" class="form-control" disabled value="(auto-generated)" />
                        <small class="form-text text-muted">Value is auto-generated at apply time</small>
                    }
                    else
                    {
                        <label class="form-label">Default Value</label>
                        <input type="text" class="form-control" @bind="Field.DefaultValue" @bind:after="NotifyChanged" />
                    }
                </div>
                @if (!HasComputedValue && SupportsValidation(Field.ControlType ?? Field.DataType))
                {
                    <div class="col-md-6">
                        <label class="form-label">Validation Regex</label>
                        <input type="text" class="form-control" @bind="Field.ValidationRegex" @bind:after="NotifyChanged" placeholder="Regex pattern" />
                    </div>
                }
            </div>
            @if (ShowMaxLengthOption(Field.ControlType ?? Field.DataType))
            {
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Max Length</label>
                        <input type="number" class="form-control" @bind="Field.MaxLength" @bind:after="NotifyChanged" min="0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Validation Message</label>
                        <input type="text" class="form-control" @bind="Field.ValidationMessage" @bind:after="NotifyChanged" placeholder="Custom error message" />
                    </div>
                </div>
            }
            }
              @if (Inline && ((!PresentationOnly && Field.ControlType == "searchable-select") ||
                  (Field.OptionSource == FieldOptionSource.Static && (Field.ControlType is "select" or "searchable-select" or "radio" || Field.DataType is "select" or "searchable-select" or "radio"))))
              {
                  <h3 class="h6 border-bottom pb-2 mt-4 mb-3">Options</h3>
              }
              @if (!PresentationOnly && Field.ControlType == "searchable-select")
              {
                <LookupConfigurationEditor Field="Field" DatabaseConnectionName="@DatabaseConnectionName" Fields="Fields" OnChanged="NotifyChanged" />
              }
              @if (Field.OptionSource == FieldOptionSource.Static && (Field.ControlType == "select" || Field.ControlType == "searchable-select" || Field.ControlType == "radio" ||
                  Field.DataType == "select" || Field.DataType == "searchable-select" || Field.DataType == "radio"))
            {
                <div class="row mb-2">
                    <div class="col-12">
                        <label class="form-label">Options (one per line)</label>
                        <textarea class="form-control" rows="3" @bind="Field.DropdownOptions" @bind:after="NotifyChanged" disabled="@(PresentationOnly && IsConditionParent)" placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
                        <small class="form-text text-muted">Enter each option on a new line</small>
                    </div>
                </div>
            }
            @if (!PresentationOnly)
            {
            @if (Inline) { <h3 class="h6 border-bottom pb-2 mt-4 mb-3">Behavior</h3> }
            <div class="row mb-2">
                <div class="col-md-3">
                    <div class="form-check" title="@(HasComputedValue ? "Auto-generated fields cannot be required" : "")">
                        <input class="form-check-input" type="checkbox" @bind="Field.IsRequired" @bind:after="NotifyChanged" disabled="@HasComputedValue" />
                        <label class="form-check-label">Required</label>
                        @if (HasComputedValue)
                        {
                            <small class="d-block text-muted">Disabled (auto-generated)</small>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="Field.IsReadOnly" @bind:after="NotifyChanged" />
                        <label class="form-check-label">Read Only</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="Field.IsVisible" @bind:after="NotifyChanged" />
                        <label class="form-check-label">Visible</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="Field.IsVisibleInDataView" @bind:after="NotifyChanged" />
                        <label class="form-check-label">Visible in Data View</label>
                    </div>
                </div>
                <div class="col-md-3">
                    @{
                        var isNullable = ColumnInfo?.IsNullable ?? true;
                        var eligibleForBlankAsNull = isNullable && !Field.IsRequired;
                        if (Field.IsRequired && Field.TreatBlankAsNull)
                        {
                            Field.TreatBlankAsNull = false;
                        }
                    }
                    <div class="form-check" title="Treat blank input as NULL when saved (only for nullable, non-required fields)">
                        <input class="form-check-input" type="checkbox" @bind="Field.TreatBlankAsNull" @bind:after="NotifyChanged" disabled="@(!eligibleForBlankAsNull)" />
                        <label class="form-check-label">Blank is NULL</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check" title="Values in this field must be unique across all records">
                        <input class="form-check-input" type="checkbox" @bind="Field.IsUnique" @bind:after="NotifyChanged" />
                        <label class="form-check-label">Unique</label>
                        @if (ColumnInfo?.IsUnique == true)
                        {
                            <small class="d-block text-muted">DB constraint</small>
                        }
                    </div>
                </div>
            </div>
            }
            @if (Inline) { <h3 class="h6 border-bottom pb-2 mt-4 mb-3">Help</h3> }
            <div class="row mb-2">
                <div class="col-12">
                    <label class="form-label">Help Text (Tooltip)</label>
                    <textarea class="form-control" rows="2" @bind="Field.HelpText" @bind:after="NotifyChanged" placeholder="Optional tooltip shown via info icon next to field label"></textarea>
                    <small class="form-text text-muted">When provided, an info icon will appear next to the field label</small>
                </div>
            </div>
            @if (!PresentationOnly)
            {
            <ConditionEditor Fields="Fields" ExcludedField="@Field.Name" @bind-Value="Field.VisibilityCondition" @bind-Value:after="NotifyChanged" />
            @if (Inline) { <h3 class="h6 border-bottom pb-2 mt-4 mb-3">Generated Value</h3> }
            <div class="row mb-2">
                <div class="col-md-6">
                    <label class="form-label">Computed Value</label>
                    <select class="form-select" value="@ComputedValueTypeInt" @onchange="OnComputedValueTypeChanged">
                        <option value="0">None (user-entered)</option>
                        @foreach (var option in GetComputedValueOptions())
                        {
                            <option value="@((int)option.Value)">@option.Label</option>
                        }
                    </select>
                    <small class="form-text text-muted">When set, the value is auto-generated when the request is applied to the database</small>
                </div>
                @if (HasComputedValue)
                {
                    <div class="col-md-6">
                        <label class="form-label">Apply On</label>
                        <select class="form-select" @bind="Field.ComputedValueApplyMode" @bind:after="NotifyChanged">
                            <option value="@ComputedValueApplyMode.InsertAndUpdate">Insert &amp; Update</option>
                            <option value="@ComputedValueApplyMode.InsertOnly">Insert Only</option>
                            <option value="@ComputedValueApplyMode.UpdateOnly">Update Only</option>
                        </select>
                        <small class="form-text text-muted">Which request types should auto-generate this value</small>
                    </div>
                }
            </div>
            }
        }
    </div>;
}

@code {
    private Modal _modal = default!;

    /// <summary>
    /// The field being configured
    /// </summary>
    [Parameter] public FormField? Field { get; set; }
    [Parameter] public bool Inline { get; set; }
    [Parameter] public List<FormField> Fields { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    private Task NotifyChanged() => OnChanged.InvokeAsync();
    [Parameter] public bool PresentationOnly { get; set; }
    [Parameter] public string DatabaseConnectionName { get; set; } = "";

    /// <summary>
    /// The original SQL type of the field
    /// </summary>
    [Parameter] public string SqlType { get; set; } = "varchar";

    /// <summary>
    /// Column info for the field (used to check nullability)
    /// </summary>
    [Parameter] public ColumnInfo? ColumnInfo { get; set; }

    /// <summary>
    /// Event callback when the modal is closed
    /// </summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private string ModalTitle => Field != null ? $"Configure Field: {Field.DisplayName}" : "Configure Field";

    private List<(string Value, string Text)> AvailableControlTypes => GetAvailableControlTypes();

    private bool HasComputedValue => Field?.ComputedValueType != null && Field.ComputedValueType != ComputedValueType.None;
    [Parameter] public List<FormSection> Sections { get; set; } = new();
    private bool IsConditionParent => Fields.Any(candidate => candidate.LookupParentField == Field?.Name || Requestr.Core.Validation.FormConditions.Parse(candidate.VisibilityCondition)?.Field == Field?.Name)
        || Sections.Any(section => Requestr.Core.Validation.FormConditions.Parse(section.VisibilityCondition)?.Field == Field?.Name);
    
    private int ComputedValueTypeInt => Field?.ComputedValueType != null ? (int)Field.ComputedValueType : 0;

    public async Task ShowAsync()
    {
        await _modal.ShowAsync();
    }

    public async Task CloseAsync()
    {
        await _modal.HideAsync();
        await OnClosed.InvokeAsync();
    }

    private async Task OnControlTypeChanged()
    {
        if (Field == null || PresentationOnly) return;
        if (Field.ControlType != "searchable-select")
        {
            Field.OptionSource = FieldOptionSource.Static;
            Field.LookupParentField = Field.LookupFilterColumn = null;
            Field.LookupFilterLevels.Clear();
        }

        // Clear validation regex if control type doesn't support it
        if (!SupportsValidation(Field.ControlType ?? ""))
        {
            Field.ValidationRegex = null;
        }

        // Reset max length for controls that don't support it
        if (!ShowMaxLengthOption(Field.ControlType ?? ""))
        {
            Field.MaxLength = 0;
        }

        // Set appropriate default values based on control type
        if (string.IsNullOrEmpty(Field.DefaultValue))
        {
            Field.DefaultValue = Field.ControlType switch
            {
                "checkbox" => "false",
                "number" or "range" => "0",
                "date" => DateTime.Today.ToString("yyyy-MM-dd"),
                "datetime-local" => DateTime.Now.ToString("yyyy-MM-ddTHH:mm"),
                "time" => DateTime.Now.ToString("HH:mm"),
                _ => ""
            };
        }
        await NotifyChanged();
    }

    private bool SupportsValidation(string controlType)
    {
        return controlType switch
        {
            "text" or "email" or "tel" or "url" or "password" or "textarea" or "suggested-text" or "searchable-select" => true,
            "number" => true,
            _ => false
        };
    }

    private bool ShowMaxLengthOption(string controlType)
    {
        return controlType switch
        {
            "text" or "email" or "tel" or "url" or "password" or "textarea" or "suggested-text" or "searchable-select" => true,
            _ => false
        };
    }

    private List<(string Value, string Text)> GetAvailableControlTypes()
    {
        var options = new List<(string Value, string Text)>();
        var sqlType = SqlType?.ToLower() ?? "varchar";

        switch (sqlType)
        {
            case var type when type.Contains("bit"):
                options.Add(("checkbox", "Checkbox"));
                options.Add(("select", "Dropdown (Yes/No)"));
                options.Add(("radio", "Radio Buttons"));
                break;

            case var type when type.Contains("int") || type.Contains("decimal") || type.Contains("numeric") || 
                              type.Contains("float") || type.Contains("real") || type.Contains("money"):
                options.Add(("number", "Number Input"));
                if (type.Contains("int")) options.Add(("searchable-select", "Searchable Dropdown"));
                options.Add(("text", "Text Input"));
                options.Add(("select", "Dropdown"));
                options.Add(("checkbox", "Checkbox"));
                options.Add(("range", "Slider"));
                break;

            case var type when type.Contains("date") && !type.Contains("datetime"):
                options.Add(("date", "Date Picker"));
                options.Add(("text", "Text Input"));
                break;

            case var type when type.Contains("datetime") || type.Contains("smalldatetime"):
                options.Add(("datetime-local", "DateTime Picker"));
                options.Add(("date", "Date Only"));
                options.Add(("text", "Text Input"));
                break;

            case var type when type.Contains("time"):
                options.Add(("time", "Time Picker"));
                options.Add(("text", "Text Input"));
                break;

            case var type when type.Contains("text") || type.Contains("ntext") || 
                              (type.Contains("varchar") && IsLongText(type)) || 
                              (type.Contains("nvarchar") && IsLongText(type)):
                options.Add(("textarea", "Text Area"));
                options.Add(("text", "Text Input"));
                options.Add(("suggested-text", "Text Input with Suggestions"));
                options.Add(("searchable-select", "Searchable Dropdown"));
                break;

            case var type when type.Contains("varchar") || type.Contains("nvarchar") || 
                              type.Contains("char") || type.Contains("nchar"):
                options.Add(("text", "Text Input"));
                options.Add(("email", "Email Input"));
                options.Add(("tel", "Phone Input"));
                options.Add(("url", "URL Input"));
                options.Add(("password", "Password Input"));
                options.Add(("select", "Dropdown"));
                options.Add(("suggested-text", "Text Input with Suggestions"));
                options.Add(("searchable-select", "Searchable Dropdown"));
                options.Add(("radio", "Radio Buttons"));
                options.Add(("checkbox", "Checkbox"));
                options.Add(("textarea", "Text Area"));
                break;

            case var type when type.Contains("uniqueidentifier"):
                options.Add(("text", "Text Input (GUID)"));
                options.Add(("searchable-select", "Searchable Dropdown"));
                break;

            default:
                options.Add(("text", "Text Input"));
                options.Add(("textarea", "Text Area"));
                options.Add(("select", "Dropdown"));
                options.Add(("checkbox", "Checkbox"));
                break;
        }

        return options;
    }

    private async Task OnComputedValueTypeChanged(ChangeEventArgs e)
    {
        if (Field == null || PresentationOnly) return;
        var intValue = int.Parse(e.Value?.ToString() ?? "0");
        if (intValue == 0)
        {
            Field.ComputedValueType = null;
            Field.ComputedValueApplyMode = ComputedValueApplyMode.InsertAndUpdate;
        }
        else
        {
            Field.ComputedValueType = (ComputedValueType)intValue;
            // Auto-generated fields cannot be required
            Field.IsRequired = false;
        }
        await NotifyChanged();
    }

    private List<(ComputedValueType Value, string Label)> GetComputedValueOptions()
    {
        var options = new List<(ComputedValueType Value, string Label)>();
        var sqlType = SqlType?.ToLower() ?? "varchar";

        // DateTime types
        if (sqlType.Contains("datetime") || sqlType.Contains("smalldatetime") || sqlType.Contains("date"))
        {
            options.Add((ComputedValueType.CurrentDateTimeUtc, "Current Date/Time (UTC)"));
            options.Add((ComputedValueType.CurrentDateTimeLocal, "Current Date/Time (Local)"));
        }

        // String types — can hold user ID, display name, or email
        if (sqlType.Contains("varchar") || sqlType.Contains("nvarchar") || sqlType.Contains("char") || 
            sqlType.Contains("nchar") || sqlType.Contains("text") || sqlType.Contains("ntext"))
        {
            options.Add((ComputedValueType.CurrentUserId, "Current User ID"));
            options.Add((ComputedValueType.CurrentUserDisplayName, "Current User Display Name"));
            options.Add((ComputedValueType.CurrentUserEmail, "Current User Email"));
        }

        // GUID type
        if (sqlType.Contains("uniqueidentifier"))
        {
            options.Add((ComputedValueType.NewGuid, "New GUID"));
        }

        // Also allow string columns to hold GUIDs (as text)
        if (sqlType.Contains("varchar") || sqlType.Contains("nvarchar") || sqlType.Contains("char") || sqlType.Contains("nchar"))
        {
            options.Add((ComputedValueType.NewGuid, "New GUID"));
        }

        return options;
    }

    private bool IsLongText(string sqlDataType)
    {
        if (sqlDataType.Contains("("))
        {
            var lengthPart = sqlDataType.Split('(')[1].Split(')')[0];
            if (int.TryParse(lengthPart, out int length))
            {
                return length > 255;
            }
        }
        return false;
    }
}
