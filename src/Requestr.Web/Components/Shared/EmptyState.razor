@* Standardized empty state component *@

<div class="empty-state text-center py-5">
    <i class="bi @Icon empty-state-icon" aria-hidden="true"></i>
    <h3 class="h5 mt-3 mb-1">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="text-muted mb-0">@Description</p>
    }
    @if (Action != null)
    {
        <div class="mt-3">
            @Action
        </div>
    }
</div>

@code {
    /// <summary>
    /// Title for the empty state
    /// </summary>
    [Parameter] public string Title { get; set; } = "No Items Found";

    /// <summary>
    /// Bootstrap icon class shown above the title
    /// </summary>
    [Parameter] public string Icon { get; set; } = "bi-inbox";

    /// <summary>
    /// Optional description for the empty state
    /// </summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>
    /// Optional action button or link
    /// </summary>
    [Parameter] public RenderFragment? Action { get; set; }
}
